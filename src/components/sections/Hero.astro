---
import { Icon } from 'astro-icon/components';
import { site } from '../../content/site';
import Envelope from '../ui/Envelope.astro';
import PhoneMockup from '../ui/PhoneMockup.astro';
import StoreBadges from '../ui/StoreBadges.astro';
import HeroLogScreen from '../ui/screens/HeroLogScreen.astro';

const { hero } = site;
const [first, second, third] = hero.envelopes;
const drained = hero.envelopes.find((envelope) => envelope.name === hero.demo.envelope);
const isDrained = (name: string) => drained?.name === name;
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div
    class="container-page grid items-center gap-14 pt-[calc(var(--spacing-nav)+3rem)] pb-20 lg:grid-cols-12 lg:gap-8 lg:pt-[calc(var(--spacing-nav)+4.5rem)] lg:pb-28"
  >
    <div class="flex flex-col items-start gap-7 lg:col-span-6">
      <h1 id="hero-title" class="font-display text-display text-ink">{hero.headline}</h1>
      <p class="max-w-[34rem] text-lead text-neutral-600">{hero.subcopy}</p>

      <div class="flex flex-wrap items-center gap-x-7 gap-y-5 pt-1">
        <StoreBadges />
        <a href={hero.secondaryLink.href} class="hero-secondary link-underline">
          {hero.secondaryLink.label}
          <Icon name="lucide:arrow-down-right" aria-hidden="true" class="size-4" />
        </a>
      </div>

      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-600">
        <span class="hero-stars" aria-hidden="true">
          {
            Array.from({ length: 5 }, () => (
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="m12 2.5 2.94 6.13 6.56.86-4.8 4.62 1.2 6.68L12 17.6l-5.9 3.19 1.2-6.68-4.8-4.62 6.56-.86Z" />
              </svg>
            ))
          }
        </span>
        <span>
          <strong class="font-semibold text-ink tabular">{hero.rating.score}</strong>{' '}
          {hero.rating.outOf} · {hero.rating.detail}
        </span>
      </p>
    </div>

    <figure class="lg:col-span-6">
      <figcaption class="sr-only">{hero.visualLabel}</figcaption>
      <div class="stage" aria-hidden="true">
        <div class="stage-glow"></div>

        {
          first && (
            <div class="layer layer-a">
              <div class="enter">
                <Envelope envelope={first} />
              </div>
            </div>
          )
        }

        {
          second && (
            <div class="layer layer-b">
              <div class="enter">
                <Envelope envelope={second} tone="tint" showBudget={false} />
              </div>
            </div>
          )
        }

        {
          third && (
            <div class="layer layer-c">
              <div class="enter" style="--drain-delay: 2.8s">
                <Envelope
                  envelope={third}
                  align="end"
                  from={isDrained(third.name) ? hero.demo.remainingBefore : undefined}
                  delta={isDrained(third.name) ? hero.demo.amount : undefined}
                />
              </div>
            </div>
          )
        }

        <div class="layer layer-phone">
          <div class="enter">
            <div class="float">
              <PhoneMockup>
                <HeroLogScreen />
              </PhoneMockup>
            </div>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<script>
  /* Counts the drained envelope down in sync with its CSS animation. */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const amount = document.querySelector<HTMLElement>('[data-envelope-amount]');

  if (amount && !reduce) {
    const from = Number(amount.dataset.from);
    const to = Number(amount.dataset.to);
    const prefix = amount.dataset.prefix ?? '';
    const format = new Intl.NumberFormat(amount.dataset.locale);
    const render = (value: number) => {
      amount.textContent = `${prefix}${format.format(Math.round(value / 100) * 100)}`;
    };
    const level = amount.closest('.envelope')?.querySelector('.envelope-level');
    let started = false;

    const run = () => {
      if (started) return;
      started = true;
      const duration = 900;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 4);
        render(from + (to - from) * eased);
        if (t < 1) requestAnimationFrame(tick);
        else render(to);
      };
      requestAnimationFrame(tick);
    };

    if (Number.isFinite(from) && Number.isFinite(to)) {
      render(from);
      level?.addEventListener('animationstart', run, { once: true });
      /* Safety net: never leave the stale value on screen. */
      window.setTimeout(run, 4500);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
  }

  .hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero-stars {
    display: inline-flex;
    gap: 0.125rem;
    color: var(--color-brand);
  }

  .hero-stars :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .hero-stars path {
    fill: currentColor;
  }

  /* ---------- Stage ---------- */

  .stage {
    position: relative;
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
    aspect-ratio: 1 / 1.08;
  }

  .stage-glow {
    position: absolute;
    inset: -8% -14%;
    background:
      radial-gradient(closest-side at 52% 48%, color-mix(in oklab, var(--color-brand) 34%, transparent), transparent),
      radial-gradient(closest-side at 50% 52%, color-mix(in oklab, var(--color-brand-soft) 90%, transparent) 30%, transparent);
  }

  .layer {
    position: absolute;
  }

  .layer-phone {
    z-index: 3;
    left: 27%;
    top: 1%;
    width: 46%;
    --parallax: -56px;
  }

  .layer-phone .enter {
    rotate: -6deg;
  }

  .layer-a {
    z-index: 1;
    left: -3%;
    top: 6%;
    width: 41%;
    --parallax: -24px;
    --fan-x: 40%;
    --fan-y: 30%;
  }

  .layer-a .enter {
    rotate: -9deg;
  }

  .layer-b {
    z-index: 1;
    left: 0%;
    top: 58%;
    width: 36%;
    --parallax: -12px;
    --fan-x: 50%;
    --fan-y: -20%;
  }

  .layer-b .enter {
    rotate: 5deg;
  }

  .layer-c {
    z-index: 2;
    right: -4%;
    top: 30%;
    width: 46%;
    --parallax: -36px;
    --fan-x: -40%;
    --fan-y: 0%;
  }

  .layer-c .enter {
    rotate: 6deg;
  }

  @media (max-width: 63.99rem) {
    .layer-phone {
      left: 23%;
      width: 54%;
    }

    .layer-a,
    .layer-c {
      width: 44%;
    }

    .layer-b {
      width: 40%;
    }
  }

  /* Phones: smaller phone, envelopes pushed out so tags and amounts clear it. */
  @media (max-width: 39.99rem) {
    .stage {
      margin-bottom: 3.5rem;
    }

    .layer-phone {
      left: 29%;
      width: 42%;
    }

    .layer-a {
      left: -5%;
      top: 7%;
      width: 40%;
    }

    .layer-b {
      z-index: 4;
      left: -3%;
      top: 72%;
      width: 40%;
    }

    .layer-c {
      right: -5%;
      top: 36%;
      width: 40%;
    }
  }

  /* ---------- Orchestrated entrance, float and parallax ---------- */

  @media (prefers-reduced-motion: no-preference) {
    .stage-glow {
      animation: glow-in 1200ms var(--ease-out-expo) both;
    }

    .layer-phone .enter {
      animation: phone-in 900ms var(--ease-out-expo) 150ms both;
    }

    .layer-a .enter,
    .layer-b .enter,
    .layer-c .enter {
      animation: fan-out 900ms var(--ease-out-expo) both;
    }

    .layer-c .enter {
      animation-delay: 450ms;
    }

    .layer-a .enter {
      animation-delay: 550ms;
    }

    .layer-b .enter {
      animation-delay: 650ms;
    }

    .float {
      animation: float 6s var(--ease-in-out-sine) 1.1s infinite alternate;
    }

    @supports (animation-timeline: scroll()) {
      .layer {
        animation: parallax linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes glow-in {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
  }

  @keyframes phone-in {
    from {
      opacity: 0;
      transform: translateY(48px);
      rotate: 0deg;
    }
  }

  @keyframes fan-out {
    from {
      opacity: 0;
      transform: translate(var(--fan-x), var(--fan-y)) scale(0.9);
      rotate: 0deg;
    }
  }

  @keyframes float {
    to {
      transform: translateY(-12px);
    }
  }

  @keyframes parallax {
    to {
      translate: 0 var(--parallax);
    }
  }
</style>
