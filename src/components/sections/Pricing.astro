---
import { Icon } from 'astro-icon/components';
import { site } from '../../content/site';
import { formatMoney } from '../../lib/format';
import SectionHeader from '../ui/SectionHeader.astro';

const { pricing } = site;
---

<section id="precios" class="pricing py-section" aria-labelledby="precios-title">
  <div class="container-page">
    <SectionHeader id="precios-title" heading={pricing.heading} intro={pricing.intro} align="center" />

    <ul class="plans mt-14 md:mt-16">
      {
        pricing.plans.map((plan, index) => {
          const titleId = `plan-${index}`;
          return (
            <li
              class="plan card-lift"
              data-highlighted={plan.highlighted ? '' : undefined}
              data-reveal
              style={`--reveal-delay:${index}`}
            >
              <article class="plan-inner" aria-labelledby={titleId}>
                <div class="plan-head">
                  <h3 id={titleId} class="plan-name">
                    {plan.name}
                  </h3>
                  {plan.badge && <span class="plan-badge tag-label">{plan.badge}</span>}
                </div>
                <p class="plan-description">{plan.description}</p>
                <p class="plan-price">
                  <span class="plan-amount tabular">{formatMoney(plan.price)}</span>
                  <span class="plan-period">{plan.period}</span>
                </p>
                <p class="plan-note">{plan.note}</p>
                <a href={plan.cta.href} class="plan-cta">
                  {plan.cta.label}
                </a>
                <ul class="plan-features">
                  {plan.features.map((feature) => (
                    <li>
                      <Icon name="lucide:check" aria-hidden="true" />
                      {feature}
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          );
        })
      }
    </ul>

    <p class="mt-8 text-center text-sm text-neutral-600">{pricing.currencyNote}</p>
  </div>
</section>

<style>
  .pricing {
    background-color: var(--color-surface);
    border-block: 1px solid color-mix(in oklab, var(--color-ink) 6%, transparent);
  }

  .plans {
    display: grid;
    gap: 1rem;
    max-width: 68rem;
    margin-inline: auto;
  }

  @media (min-width: 64rem) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
      align-items: center;
      gap: 1.25rem;
    }
  }

  .plan {
    display: flex;
    border: 1px solid color-mix(in oklab, var(--color-ink) 9%, transparent);
    border-radius: var(--radius-panel);
    background-color: var(--color-paper);
  }

  .plan[data-highlighted] {
    border-color: var(--color-ink);
    background-color: var(--color-ink);
    color: var(--color-paper);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 64rem) {
    .plan[data-highlighted] .plan-inner {
      padding-block: 2.75rem;
    }
  }

  .plan-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .plan-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .plan-name {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 680;
    letter-spacing: -0.02em;
  }

  .plan-badge {
    padding: 0.375rem 0.625rem;
    border-radius: 9999px;
    background-color: var(--color-brand);
    color: var(--color-ink);
  }

  .plan-description {
    font-size: 0.9375rem;
    color: var(--color-neutral-600);
  }

  [data-highlighted] .plan-description,
  [data-highlighted] .plan-note,
  [data-highlighted] .plan-period {
    color: var(--color-neutral-300);
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .plan-amount {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .plan-period {
    font-size: 0.9375rem;
    color: var(--color-neutral-600);
  }

  .plan-note {
    min-height: 1.5em;
    font-size: 0.875rem;
    color: var(--color-neutral-600);
  }

  .plan-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    margin-block: 0.75rem 0.5rem;
    border-radius: 9999px;
    background-color: var(--color-ink);
    color: var(--color-paper);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo);
  }

  .plan-cta:hover {
    background-color: var(--color-neutral-800);
    transform: scale(1.02);
  }

  .plan-cta:focus-visible {
    border-radius: 9999px;
  }

  [data-highlighted] .plan-cta {
    background-color: var(--color-brand);
    color: var(--color-ink);
  }

  [data-highlighted] .plan-cta:hover {
    background-color: var(--color-brand-soft);
  }

  [data-highlighted] .plan-cta:focus-visible {
    outline-color: var(--color-brand);
  }

  .plan-features {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in oklab, currentColor 12%, transparent);
    font-size: 0.9375rem;
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .plan-features :global(svg) {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
    color: var(--color-brand-strong);
  }

  [data-highlighted] .plan-features :global(svg) {
    color: var(--color-brand);
  }
</style>
