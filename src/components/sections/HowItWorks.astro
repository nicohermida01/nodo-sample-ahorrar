---
import { site } from '../../content/site';
import PhoneMockup from '../ui/PhoneMockup.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import LogScreen from '../ui/screens/LogScreen.astro';
import OverviewScreen from '../ui/screens/OverviewScreen.astro';
import SetupScreen from '../ui/screens/SetupScreen.astro';

const { howItWorks } = site;
/*
 * To use real screenshots instead of the HTML screens, import them from
 * src/assets/mockups and pass them as `screenshot` (plus `alt`) to PhoneMockup.
 */
const screens = [SetupScreen, LogScreen, OverviewScreen];
---

<section id="como-funciona" class="steps-section py-section" aria-labelledby="como-funciona-title">
  <div class="container-page">
    <SectionHeader
      id="como-funciona-title"
      heading={howItWorks.heading}
      intro={howItWorks.intro}
      align="center"
    />

    <ol class="steps mt-14 md:mt-20">
      {
        howItWorks.steps.map((step, index) => {
          const Screen = screens[index];
          return (
            <li class="step" data-reveal style={`--reveal-delay:${index}`}>
              <div class="step-phone">
                <PhoneMockup label={step.screenLabel}>{Screen && <Screen />}</PhoneMockup>
              </div>
              <div class="step-copy">
                <span class="step-number tabular" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="font-display text-heading font-semibold text-ink">{step.title}</h3>
                <p class="text-[0.9375rem] leading-relaxed text-neutral-600">{step.body}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .steps-section {
    background-color: var(--color-neutral-50);
    border-block: 1px solid color-mix(in oklab, var(--color-ink) 6%, transparent);
  }

  .steps {
    display: grid;
    gap: 4rem;
    counter-reset: step;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .step:nth-child(2) {
      margin-top: 3rem;
    }
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .step-phone {
    width: min(100%, 15.5rem);
  }

  .step-copy {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: 21rem;
    text-align: center;
    align-items: center;
  }

  .step-number {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    height: 1.75rem;
    padding-inline: 0.5rem;
    margin-bottom: 0.25rem;
    border-radius: var(--radius-tag);
    background-color: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
</style>
