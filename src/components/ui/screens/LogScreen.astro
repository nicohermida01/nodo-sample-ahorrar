---
import '../../../styles/screens.css';
import { site } from '../../../content/site';
import { formatMoney } from '../../../lib/format';
import StatusBar from './StatusBar.astro';

const screen = site.howItWorks.logScreen;
---

<div class="scr">
  <StatusBar />
  <p class="scr-title">{screen.title}</p>

  <div class="log-amount">
    <span class="scr-amount log-amount-value">{formatMoney(screen.amount)}</span>
    <span class="scr-muted">{screen.description}</span>
  </div>

  <div class="scr-chips log-chips">
    {
      screen.chips.map((chip, index) => (
        <span class="scr-chip">
          {chip}
          {index === screen.selectedChip && <span class="scr-chip-on">{chip}</span>}
        </span>
      ))
    }
  </div>

  <div class="scr-card log-details">
    {
      screen.details.map((detail) => (
        <div class="scr-row">
          <span class="scr-muted">{detail.label}</span>
          <span class="scr-num">{detail.value}</span>
        </div>
      ))
    }
  </div>

  <div class="log-keys">
    {screen.keys.map((key) => <span class="log-key tabular">{key}</span>)}
  </div>

  <span class="scr-btn">{screen.action}</span>
</div>

<style>
  .log-details {
    padding: 0.1em 1em;
  }

  .log-amount {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3em;
    padding-block: 1.4em 0.6em;
  }

  .log-amount-value {
    font-size: 3.4em;
  }

  .log-chips {
    justify-content: center;
  }

  .log-keys {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35em;
    margin-top: auto;
  }

  .log-key {
    display: grid;
    place-items: center;
    height: 3.1em;
    border-radius: 0.7em;
    background-color: var(--color-surface);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-ink) 7%, transparent);
    font-size: 1.05em;
    font-weight: 560;
  }
</style>
