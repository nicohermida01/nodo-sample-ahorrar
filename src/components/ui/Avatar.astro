---
interface Props {
  initials: string;
  tone?: 'brand' | 'accent' | 'ink';
}

const { initials, tone = 'brand' } = Astro.props;
---

<span class="avatar tag-label tabular" data-tone={tone} aria-hidden="true">{initials}</span>

<style>
  .avatar {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: var(--radius-control);
    font-size: 0.8125rem;
    background-color: var(--color-brand-soft);
    color: var(--color-brand-strong);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-brand) 22%, transparent);
  }

  .avatar[data-tone='accent'] {
    background-color: var(--color-accent-soft);
    color: var(--color-accent-strong);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-accent) 22%, transparent);
  }

  .avatar[data-tone='ink'] {
    background-color: var(--color-ink);
    color: var(--color-paper);
    box-shadow: none;
  }
</style>
