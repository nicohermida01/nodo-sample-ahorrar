---
import { site } from '../../content/site';

interface Props {
  tone?: 'ink' | 'paper';
  class?: string;
}

const { tone = 'ink', class: className } = Astro.props;
---

<span class:list={['logo', className]} data-tone={tone}>
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" class="logo-bg"></rect>
    <path d="M8 14.5 16 7.5l8 7Z" class="logo-flap"></path>
    <rect x="12" y="10" width="8" height="8" rx="1" class="logo-bill"></rect>
    <rect x="8" y="14.5" width="16" height="10.5" rx="1.75" class="logo-body"></rect>
    <path d="m8.75 24.25 7.25-5.5 7.25 5.5" class="logo-fold"></path>
  </svg>
  <span class="logo-word">{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
  }

  .logo[data-tone='paper'] {
    color: var(--color-paper);
  }

  .logo-mark {
    width: 2rem;
    height: 2rem;
    flex: none;
  }

  .logo-bg {
    fill: var(--color-brand);
  }

  .logo-flap {
    fill: var(--color-brand-soft);
  }

  .logo-bill {
    fill: var(--color-ink);
  }

  .logo-body {
    fill: var(--color-surface);
  }

  .logo-fold {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 760;
    letter-spacing: -0.035em;
    line-height: 1;
  }
</style>
