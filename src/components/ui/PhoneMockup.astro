---
/**
 * CSS phone frame. Pass either an HTML screen through the default slot,
 * or a real `screenshot` (ImageMetadata from src/assets) that is rendered
 * with astro:assets as responsive AVIF/WebP.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  /** Real app screenshot. When present, the slot is ignored. */
  screenshot?: ImageMetadata;
  /** Alt text for the screenshot. */
  alt?: string;
  /** Accessible description for an HTML (slot) screen. */
  label?: string;
  /** Load the screenshot eagerly (above the fold). */
  priority?: boolean;
  class?: string;
}

const { screenshot, alt = '', label, priority = false, class: className } = Astro.props;
const describesSlot = !screenshot && label;
---

<div
  class:list={['phone', className]}
  role={describesSlot ? 'img' : undefined}
  aria-label={describesSlot ? label : undefined}
>
  <div class="phone-frame">
    <div class="phone-screen">
      {
        screenshot ? (
          <Picture
            src={screenshot}
            alt={alt}
            formats={['avif', 'webp']}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 320px, 70vw"
            loading={priority ? 'eager' : 'lazy'}
            decoding="async"
            class="phone-shot"
          />
        ) : (
          <div class="phone-ui" aria-hidden={describesSlot ? 'true' : undefined}>
            <slot />
          </div>
        )
      }
      <span class="phone-island" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .phone {
    container-type: inline-size;
    width: 100%;
  }

  .phone-frame {
    padding: 2.8cqi;
    border-radius: 15cqi;
    background-color: var(--color-ink);
    box-shadow:
      inset 0 0 0 1px var(--color-neutral-700),
      inset 0 0 0 2.5px var(--color-ink),
      var(--shadow-phone);
  }

  .phone-screen {
    position: relative;
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border-radius: 12.4cqi;
    background-color: var(--color-paper);
  }

  .phone-island {
    position: absolute;
    top: 2.8cqi;
    left: 50%;
    width: 29cqi;
    height: 8cqi;
    translate: -50% 0;
    border-radius: 9999px;
    background-color: var(--color-ink);
  }

  .phone-ui {
    position: absolute;
    inset: 0;
    font-size: 4.3cqi;
    line-height: 1.3;
  }

  .phone-shot,
  .phone-screen :global(picture),
  .phone-screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
